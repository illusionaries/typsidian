{
  "name": "typsidian",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "An Obsidian-like editor for Typst with a universal, language-agnostic document core.",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "bun --watch server/index.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:server": "bun scripts/build-server.mjs",
    "build:icon": "bun scripts/build-icon.mjs",
    "build:native": "cargo build --release --manifest-path native/Cargo.toml",
    "desktop:build": "bun run build:native && bun run build:server && bun run build:web && bun run build:icon",
    "desktop:run": "bun run desktop:build && electron electron/main.cjs",
    "desktop:package": "bun run desktop:build && electron-builder --mac --arm64 --dir",
    "desktop:dmg": "bun run desktop:build && electron-builder --mac --arm64",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:engine": "bun scripts/test-engine.mts",
    "test:ui": "bun scripts/verify-ui.mjs && bun scripts/verify-errors.mjs",
    "start": "NODE_ENV=production bun server/index.ts",
    "test:vaults": "bun scripts/test-vaults.mts",
    "test:app": "bun scripts/verify-app.mjs",
    "test": "bun scripts/test-engine.mts && bun scripts/test-vaults.mts"
  },
  "dependencies": {
    "@myriaddreamin/typst-ts-node-compiler": "^0.7.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "codemirror-lang-typst": "^0.6.0",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "main": "electron/main.cjs",
  "trustedDependencies": [
    "electron",
    "esbuild",
    "fsevents"
  ],
  "build": {
    "appId": "dev.typsidian.app",
    "productName": "Typsidian",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-server/**",
      "electron/**",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "sample-vault",
        "to": "sample-vault"
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "**/@myriaddreamin/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "darkModeSupport": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "artifactName": "Typsidian-${version}-${arch}.${ext}",
    "dmg": {
      "title": "Typsidian ${version}",
      "artifactName": "Typsidian-${version}-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/illusionaries/typsidian.git"
  },
  "homepage": "https://github.com/illusionaries/typsidian#readme",
  "author": "illusionaries",
  "license": "MIT"
}
